# ============================================
# TTS Service - Environment Configuration
# ============================================
# Copy this file to .env and update with your values
# cp example.env .env
#
# IMPORTANT: Never commit .env file to version control!

# ============================================
# AUTHENTICATION (REQUIRED FOR PRODUCTION)
# ============================================

# Enable API key authentication
# Set to 'true' to require authentication for all requests
# Default: false (auth is optional for development)
TTS_REQUIRE_AUTH=false

# API Keys (comma-separated)
# Generate secure random keys for production
# Example: TTS_API_KEYS="sk-prod-abc123xyz789,sk-prod-def456uvw012"
# You can have multiple keys for different clients/applications
# Leave empty for development (when TTS_REQUIRE_AUTH=false)
TTS_API_KEYS=""

# ============================================
# SERVER CONFIGURATION
# ============================================

# Server host (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
TTS_HOST=0.0.0.0

# Server port
TTS_PORT=8002

# Log level (debug, info, warning, error)
TTS_LOG_LEVEL=info

# Maximum text length per request (characters)
TTS_MAX_TEXT_LENGTH=5000

# ============================================
# MODEL CONFIGURATION
# ============================================

# Model name
TTS_MODEL_NAME=CosyVoice-300M-SFT

# Model path (relative or absolute)
TTS_MODEL_PATH=pretrained_models/CosyVoice-300M-SFT

# Device (cuda, cpu, or auto)
# auto = automatically detect (use CUDA if available, else CPU)
TTS_DEVICE=auto

# ============================================
# MODEL SCOPE CONFIGURATION
# ============================================

# Enable ModelScope auto-download
TTS_USE_MODELSCOPE=true

# ModelScope model ID for download
TTS_MODELSCOPE_MODEL_ID=iic/CosyVoice-300M-SFT

# Verify model integrity before loading
TTS_VERIFY_MODEL_INTEGRITY=true

# Automatically re-download if model is incomplete
TTS_AUTO_REPAIR_MODEL=true

# ============================================
# PRODUCTION EXAMPLE
# ============================================
# For production, use these settings:
#
# TTS_REQUIRE_AUTH=true
# TTS_API_KEYS="sk-prod-your-secret-key-1,sk-prod-your-secret-key-2"
# TTS_HOST=0.0.0.0
# TTS_PORT=8002
# TTS_LOG_LEVEL=info
# TTS_MAX_TEXT_LENGTH=5000
# TTS_MODEL_NAME=CosyVoice-300M-SFT
# TTS_MODEL_PATH=pretrained_models/CosyVoice-300M-SFT
# TTS_DEVICE=auto
# TTS_USE_MODELSCOPE=true
# TTS_MODELSCOPE_MODEL_ID=iic/CosyVoice-300M-SFT
# TTS_VERIFY_MODEL_INTEGRITY=true
# TTS_AUTO_REPAIR_MODEL=true

# ============================================
# SECURITY NOTES
# ============================================
# 1. Never commit .env file to version control
# 2. Use strong, randomly generated API keys (32+ characters)
# 3. Rotate keys regularly
# 4. Use different keys for different environments
# 5. Keep .env file permissions restricted (chmod 600 .env)
# 6. Generate keys using:
#    Python: import secrets; print(f"sk-prod-{secrets.token_urlsafe(32)}")
#    OpenSSL: openssl rand -hex 32
#    Node.js: require('crypto').randomBytes(32).toString('hex')

