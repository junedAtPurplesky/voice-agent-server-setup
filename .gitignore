# ============================================================================
# Voice Agent Server - Root Level Production .gitignore
# ============================================================================

# ===========================
# CRITICAL: CREDENTIALS & SECRETS
# ===========================
# Environment files with API keys
*.env
.env
.env.*
config/*.env
services/**/.env
llm_service/.env
stt_service/.env
tts_service/.env

# Exception: Keep template files
!.env.example*
!.env.example.stt
!config/system.env
!config/ports.conf

# Security files
*.key
*.pem
*.crt
*.p12
secrets/
credentials/
auth/
.secrets

# Backups (may contain credentials)
backups/*.tar.gz
*.backup
*.bak

# ===========================
# PYTHON ENVIRONMENT
# ===========================
# Virtual environments
venv/
env/
ENV/
.venv/
venv.bak/

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Testing
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
pytestdebug.log

# ===========================
# AI MODELS & LARGE FILES
# ===========================
# Model directories
data/models/*
!data/models/.gitkeep
cosyvoice/
models/
model_cache/
checkpoints/

# Model files (often 2GB+)
*.pt
*.pth
*.bin
*.safetensors
*.ckpt
*.onnx
*.pb
*.h5
*.tflite
*.msgpack
*.model
*.pkl
*.pickle

# Hugging Face cache
.cache/
transformers_cache/
huggingface/
hub/

# Tokenizer files (large)
*.vocab
*.spm
*.bpe

# ===========================
# RUNTIME FILES
# ===========================
# Process IDs
pids/
*.pid

# Logs (all services)
logs/
*.log
*.log.*
log/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Keep directory structure
!logs/stt/.gitkeep
!logs/tts/.gitkeep
!logs/llm/.gitkeep
!logs/nginx/.gitkeep

# Temporary files
data/temp/*
!data/temp/.gitkeep
tmp/
temp/
*.tmp
.temp/

# Lock files
*.lock
.lock

# ===========================
# MEDIA FILES (Generated/Test)
# ===========================
# Audio files
*.wav
*.mp3
*.ogg
*.flac
*.m4a
*.aac
*.wma
*.opus

# Video files
*.mp4
*.avi
*.mkv
*.mov
*.wmv
*.flv
*.webm

# Images
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.tiff
*.svg
*.ico

# Exception: Keep test fixtures if you add them
# !tests/fixtures/*.wav

# ===========================
# DOCKER & CONTAINERS
# ===========================
# Docker files (you removed Docker but just in case)
Dockerfile
docker-compose.yml
docker-compose.*.yml
.dockerignore

# Exception: If you want to keep Docker files for reference
# !Dockerfile.example

