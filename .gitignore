core
core.*

# Redis
dump.rdb

# Celery
celerybeat-schedule
celerybeat.pid

# SageMath
*.sage.py

# Environments
.env.local
.env.development.local
.env.test.local
.env.production.local

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

# ===========================
# KEEP THESE FILES (Whitelist)
# ===========================
# Documentation
!README.md
!COMMANDS.md
!DEPLOYMENT.md
!CONTRIBUTING.md
!LICENSE
!CHANGELOG.md

# Scripts (all shell scripts)
!**/*.sh

# Python source
!**/*.py

# Config examples
!**/*.example
!**/*.sample

# Directory structure markers
!**/.gitkeep

# ===========================
# PROJECT-SPECIFIC
# ===========================
# Keep pids directory but not its contents
!pids/.gitkeep

# Keep data structure
!data/models/.gitkeep
!data/temp/.gitkeep

# Ignore all old gitignore files in services (will be deleted)
services/**/.gitignore
llm_service/.gitignore
stt_service/.gitignore
tts_service/.gitignore
