#create envs in config folder with the following content and names.
#########################################################################

#file name llm.env
# LLM Service Configuration - Qwen 2.5 7B AWQ Quantized
LLM_API_KEY=llm_secret_key_production_123456
LLM_SERVICE_PORT=8002
LLM_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct-AWQ
LLM_QUANTIZATION=awq
LLM_DTYPE=float16
LLM_DEVICE=cuda

# AWQ Specific Settings
# AWQ only supports float16, NOT bfloat16
# This is important for vLLM compatibility
LLM_MAX_MODEL_LEN=4096
LLM_GPU_MEMORY_UTILIZATION=0.85


#file name stt.env
# STT Service Configuration
STT_API_KEY=stt_secret_key_production_123456
STT_SERVICE_PORT=8000
STT_MODEL_NAME=large-v3-turbo
STT_COMPUTE_TYPE=int8
STT_DEVICE=cuda


#file name tts.env
# TTS Service Configuration
TTS_API_KEY=tts_secret_key_production_123456
TTS_SERVICE_PORT=8001
TTS_MODEL_NAME=iic/CosyVoice2-0.5B
TTS_DEVICE=cuda
