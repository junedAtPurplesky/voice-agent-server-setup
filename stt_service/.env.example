# Speechmatics-Compatible STT Service Configuration
# Copy this file to .env and update with your values

# =============================================================================
# Server Configuration
# =============================================================================

# Server host (default: 0.0.0.0)
STT_HOST=0.0.0.0

# Server port (default: 8001)
STT_PORT=8001

# Log level: debug, info, warning, error (default: info)
STT_LOG_LEVEL=info

# =============================================================================
# Authentication Configuration
# =============================================================================

# Require API key authentication (default: false)
# Set to true in production to enable authentication
STT_REQUIRE_AUTH=false

# API keys (comma-separated list)
# Used when STT_REQUIRE_AUTH=true
# Example: STT_API_KEYS=key1,key2,key3
STT_API_KEYS=

# =============================================================================
# Model Configuration
# =============================================================================

# Whisper model name (default: large-v3)
# Options: tiny, base, small, medium, large, large-v2, large-v3
STT_MODEL_NAME=large-v3

# Device: cuda, cpu, or auto (default: auto)
# auto will use cuda if available, otherwise cpu
STT_DEVICE=auto

# Compute type: float16, int8, int8_float16 (default: float16 for cuda, int8 for cpu)
# float16: Best quality, requires CUDA
# int8: Lower quality, works on CPU
STT_COMPUTE_TYPE=float16

# Model cache directory (default: ./models)
# Where to store downloaded Whisper models
STT_MODEL_CACHE_DIR=./models
