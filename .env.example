# ================================================================
# VOICE AGENT CONFIGURATION
# ================================================================

# API Keys - Use these directly in requests (no JWT token needed)
# Format: Authorization: Bearer {API_KEY}
STT_API_KEY=stt_secret_key_production_123456
TTS_API_KEY=tts_secret_key_production_123456
LLM_API_KEY=llm_secret_key_production_123456

# Docker Configuration
COMPOSE_PROJECT_NAME=voice-agent-prod
DOCKER_BUILDKIT=1

# Service Names (for internal networking)
STT_SERVICE_NAME=voice-stt
TTS_SERVICE_NAME=voice-tts
LLM_SERVICE_NAME=voice-llm
NGINX_SERVICE_NAME=voice-nginx
