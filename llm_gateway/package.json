{
  "name": "llm-gateway",
  "version": "1.3.1",
  "description": "Secure proxy for vLLM-compatible endpoints with API key validation",
  "main": "dist/gateway.js",
  "scripts": {
    "dev": "tsx watch src/gateway.ts",
    "build": "tsc",
    "start": "node dist/gateway.js",
    "test:stream": "node dist/test-stream.js",
    "mock:vllm": "node dist/mock-vllm-server.js",
    "test:integration": "node dist/integration-test.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js"
  },
  "keywords": [
    "vllm",
    "proxy",
    "gateway",
    "llm"
  ],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}

